# Public canonical origin; set to the production domain for production deployments.
NEXT_PUBLIC_SITE_URL=https://belemagroup.com

# Resend (server-only). Verify belemagroup.com in Resend before sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Belema Website <website@belemagroup.com>"

# Cloudflare Turnstile (site key is public; secret is server-only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis REST credentials for shared serverless rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional analytics. Leave both empty to keep analytics disabled and hide the consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
