/// Calls for Applications — Art. 6
model CallForApplication {
  id              String   @id @default(cuid())
  title           String
  description     String?
  targetType      String   @default("both")
  status          String   @default("DRAFT")
  opensAt         DateTime
  closesAt        DateTime
  maxApplications Int?
  requirements    Json?
  issuedById      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([opensAt, closesAt])
  @@schema("directive")
}

/// Inspection & Monitoring Records — Art. 23
model Inspection {
  id          String   @id @default(cuid())
  entityId    String
  entityType  String
  scheduledAt DateTime
  completedAt DateTime?
  status      String   @default("SCHEDULED")
  inspectorId String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([status])
  @@schema("directive")
}

/// Inspection Findings — Art. 23.3
model InspectionFinding {
  id               String   @id @default(cuid())
  inspectionId     String
  description      String
  severity         String   @default("MINOR")
  status           String   @default("OPEN")
  directiveRef     String?
  correctiveAction String?
  dueDate          DateTime?
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([inspectionId])
  @@index([status, severity])
  @@schema("directive")
}

/// Appeals — Art. 35
model DirectiveAppeal {
  id             String   @id @default(cuid())
  entityId       String
  entityType     String
  decisionId     String?
  grounds        String
  description    String?
  status         String   @default("PENDING")
  filedAt        DateTime @default(now())
  appealDeadline DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([status])
  @@schema("directive")
}

/// Transitional Provisions — Art. 32
model TransitionalProvision {
  id                  String   @id @default(cuid())
  entityId            String
  entityType          String
  previousDesignation String
  newDesignation      String
  transitionDeadline  DateTime
  status              String   @default("ACTIVE")
  convertedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([status])
  @@schema("directive")
}

/// Winding Up / Surrender Requests — Art. 26-27
model SurrenderRequest {
  id                  String   @id @default(cuid())
  entityId            String
  entityType          String
  reason              String
  description         String?
  status              String   @default("DRAFT")
  submittedAt         DateTime @default(now())
  decidedAt           DateTime?
  certificateRevokedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([status])
  @@schema("directive")
}

/// Report Submissions — Art. 19.5, 20.5, 29.1
model ReportSubmission {
  id           String   @id @default(cuid())
  entityId     String
  entityType   String
  reportType   String
  notes        String?
  fileIds      Json     @default("[]")
  status       String   @default("SUBMITTED")
  submittedAt  DateTime @default(now())
  submittedById String
  submitter     User     @relation(fields: [submittedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([reportType])
  @@index([status])
  @@schema("directive")
}
