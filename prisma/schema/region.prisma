model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("incubation")
}

model HubReport {
  id          String   @id @default(cuid())
  hubId       String
  period      String   // e.g. "2026-Q1", "2026-03"
  title       String
  description String?
  metrics     Json?    // { startupsSupported, jobsCreated, trainingsHeld, ... }
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, REVIEWED
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hub Hub @relation(fields: [hubId], references: [id])

  @@index([hubId])
  @@index([status])
  @@schema("incubation")
}
