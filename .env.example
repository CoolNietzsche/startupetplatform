# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# JWT Secret
JWT_SECRET="your-jwt-secret-here"

# Resend API Key (for emails)
RESEND_API_KEY="re_..."

# SMTP Configuration (Fallback or Alternative to Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_SECURE=true
EMAIL_FROM="App Name <noreply@example.com>"

# File Storage Configuration
FILE_STORAGE_PROVIDER=LOCAL # or S3 if implemented
FILE_STORAGE_PATH=./storage/uploads

# Ethereum/Blockchain Configuration
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/..."
ETHEREUM_PRIVATE_KEY="0x..."
CERTIFICATE_CONTRACT_ADDRESS="0x..."
