# Production Environment Configuration Template
# Copy this to .env (used by Docker Compose) and customize it.

# Database Configuration (Used by db service in docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_DB=startup_et
POSTGRES_PASSWORD=securepasswordhere

# Database URL for app container connection.
# When running with docker-compose, the host is "db" (defined by service name).
DATABASE_URL="postgresql://postgres:securepasswordhere@db:5432/startup_et?schema=public&sslmode=disable"

# NextAuth Configuration
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="RUN_openssl_rand_base64_32_TO_GENERATE_THIS"
JWT_SECRET="RUN_openssl_rand_base64_32_TO_GENERATE_THIS"

# Application Configuration
APP_NAME="StartupET"
APP_URL="https://yourdomain.com"

# Email Configuration (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# File Upload Configuration
UPLOAD_DIR="/var/www/startupet/uploads"
MAX_FILE_SIZE=10485760

# Redis Configuration (Optional - for session storage)
REDIS_URL="redis://localhost:6379"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="/var/log/startupet/app.log"

# Security Configuration
CORS_ORIGIN="https://yourdomain.com"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=""

# Social Media Links (Optional)
TWITTER_URL=""
FACEBOOK_URL=""
LINKEDIN_URL=""

# API Configuration
API_BASE_URL="https://yourdomain.com/api"
API_TIMEOUT=30000

# Development/Debug (disable in production)
DEBUG=false
VERBOSE_LOGGING=false
